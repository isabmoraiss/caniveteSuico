@{
    ViewData["Title"] = "Erro";
}

<h1 class="text-danger">Erro.</h1>
<h2 class="text-danger">Ocorreu um erro ao processar sua solicitação.</h2>

@if (ViewBag.RequestId != null)
{
    <p>
        <strong>ID da Solicitação:</strong> <code>@ViewBag.RequestId</code>
    </p>
}

<h3>Modo de Desenvolvimento</h3>
<p>
    A mudança para o ambiente de <strong>Desenvolvimento</strong> exibe informações detalhadas sobre o erro que ocorreu.
</p>

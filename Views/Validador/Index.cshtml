@{
    ViewData["Title"] = "Validador de CPF e CNPJ";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm border-0 rounded-lg p-4">
            <div class="card-body">
                <h2 class="h3 font-weight-bold text-center text-dark mb-4">Validador de CPF e CNPJ</h2>

                <form asp-controller="Validador" asp-action="Index" method="post">
                    @if (ViewBag.Erro != null)
                    {
                        <div class="alert alert-danger small font-weight-bold text-center">@ViewBag.Erro</div>
                    }

                    <div class="form-group mb-4">
                        <label for="Documento" class="text-muted small font-weight-bold">Digite apenas os números</label>
                        <input id="Documento" name="documento" type="text" class="form-control form-control-lg text-dark" placeholder="Digite apenas os números" value="@ViewBag.Documento" required />
                    </div>

                    <button type="submit" class="btn btn-block btn-lg font-weight-bold text-white text-uppercase" style="background-color: #DC3545;">VERIFICAR VALIDADE</button>
                </form>

                @if (ViewBag.Calculado == true)
                {
                    <div class="mt-4 pt-3 border-top">
                        <div class="alert @(ViewBag.Valido == true ? "alert-success" : "alert-danger") px-4 py-3">
                            <div class="d-flex align-items-center">
                                <div class="mr-3">
                                    @if (ViewBag.Valido == true)
                                    {
                                        <svg width="24" height="24" fill="currentColor" class="text-success" viewBox="0 0 16 16">
                                            <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
                                        </svg>
                                    }
                                    else
                                    {
                                        <svg width="24" height="24" fill="currentColor" class="text-danger" viewBox="0 0 16 16">
                                            <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zM5.354 4.646a.5.5 0 1 0-.708.708L7.293 8l-2.647 2.646a.5.5 0 0 0 .708.708L8 8.707l2.646 2.647a.5.5 0 0 0 .708-.708L8.707 8l2.647-2.646a.5.5 0 0 0-.708-.708L8 7.293 5.354 4.646z"/>
                                        </svg>
                                    }
                                </div>
                                <div>
                                    <h5 class="mb-1 font-weight-bold">
                                        @ViewBag.Tipo @(ViewBag.Valido == true ? "VÁLIDO" : "INVÁLIDO")
                                    </h5>
                                    @if (!string.IsNullOrEmpty(ViewBag.DocumentoFormatado))
                                    {
                                        <div class="h6 font-weight-bold tracking-wider text-dark mb-1">
                                            @ViewBag.DocumentoFormatado
                                        </div>
                                    }
                                    <p class="mb-0 small opacity-90">@ViewBag.MensagemExibicao</p>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
